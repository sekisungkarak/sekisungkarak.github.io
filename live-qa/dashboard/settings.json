    {
      "id": "designWeight",
      "label": "Weight",
      "type": "slider",
      "defaultValue": 500,
      "min": 400,
      "max": 900,
      "step": 100,
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designLineGap",
      "label": "Line Gap",
      "type": "slider",
      "defaultValue": 4,
      "min": 0,
      "max": 40,
      "step": 1,
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designHlAnim",
