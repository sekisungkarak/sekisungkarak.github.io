        {
          "value": "shake",
          "label": "Shake"
        },
        {
          "value": "tada",
          "label": "Tada"
        },
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "rainbow",
          "label": "Rainbow"
        }
      ],
      "defaultValue": "none",
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "showTicketHint",
      "label": "Show Ticket Hint",
