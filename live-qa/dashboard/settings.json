      "type": "checkbox",
      "defaultValue": true,
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designOutline",
      "label": "Outline",
      "description": "Relative to the text size. 0 turns it off.",
      "type": "slider",
      "defaultValue": 0,
      "min": 0,
      "max": 0.12,
      "step": 0.002,
      "group": "Outline & shadow",
