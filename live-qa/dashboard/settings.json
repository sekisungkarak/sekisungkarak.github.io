{
  "groups": {
    "OBS Connection": {
      "open": true,
      "popup": true,
      "icon": "../../resources/icons/platforms/obs-logo.svg",
      "badge": "obs"
    },
    "Connection": {
      "open": true,
      "popup": true,
      "icon": "ri-plug-fill"
    },
    "Ticket": {
      "open": false,
      "icon": "ri-ticket-2-fill"
    },
    "Questions": {
      "open": false,
      "icon": "ri-question-answer-fill"
    },
    "Text": {
      "open": false,
      "icon": "ri-text"
    },
    "Background": {
      "open": false,
      "icon": "ri-layout-4-fill"
    },
    "Content": {
      "open": false,
      "icon": "ri-article-fill"
    },
    "Animation": {
      "open": false,
      "icon": "ri-play-circle-fill"
    }
  },
  "settings": [
    {
      "id": "obsAddress",
      "includeInWidgetParams": false,
      "label": "Server IP",
      "type": "text",
      "defaultValue": "127.0.0.1",
      "group": "OBS Connection"
    },
    {
      "id": "obsPort",
      "includeInWidgetParams": false,
      "label": "Port",
      "type": "number",
      "defaultValue": 4455,
      "min": 1024,
      "max": 65535,
      "group": "OBS Connection"
    },
    {
      "id": "obsPassword",
      "includeInWidgetParams": false,
      "label": "Password",
      "type": "password",
      "defaultValue": "",
      "group": "OBS Connection"
    },
    {
      "id": "bridgeHost",
      "label": "Bridge Host",
      "type": "text",
      "defaultValue": "127.0.0.1",
      "group": "Connection"
    },
    {
      "id": "bridgePort",
      "label": "Bridge Port",
      "type": "number",
      "defaultValue": 47800,
      "min": 1024,
      "max": 65535,
      "group": "Connection"
    },
    {
      "id": "ticketCondition",
      "label": "Ticket Condition",
      "description": "Who may ask a question. Pick one or more categories; leave empty for anyone. Gift and Likes need an action, the rest pass by status.",
      "type": "chips",
      "options": [
        { "value": "gift", "label": "Gift" },
        { "value": "follower", "label": "Follower" },
        { "value": "likes", "label": "Likes" },
        { "value": "fanclub", "label": "Fan Club" },
        { "value": "subscriber", "label": "Subscriber" },
        { "value": "superfan", "label": "Superfans" }
      ],
      "defaultValue": "",
      "group": "Ticket",
      "full": true
    },
    {
      "id": "ticketMatch",
      "label": "Match Mode",
      "description": "With several conditions: Any = match at least one (OR), All = match every one (AND).",
      "type": "select",
      "options": [
        { "value": "any", "label": "Any (OR)" },
        { "value": "all", "label": "All (AND)" }
      ],
      "defaultValue": "any",
      "group": "Ticket"
    },
    {
      "id": "ticketGiftId",
      "label": "Ticket Gift",
      "description": "The gift a viewer must send to earn a ticket. The list shows every TikTok gift with its coin price and id, so matching stays exact across languages.",
      "type": "gift",
      "defaultValue": "",
      "group": "Ticket",
      "showIf": "ticketCondition",
      "showIfValue": "gift",
      "full": true
    },
    {
      "id": "ticketLikeCount",
      "label": "Likes Required",
      "description": "How many likes a viewer must send to earn a ticket.",
      "type": "number",
      "defaultValue": 30,
      "min": 1,
      "group": "Ticket",
      "showIf": "ticketCondition",
      "showIfValue": "likes"
    },
    {
      "id": "questionPrefix",
      "label": "Question Prefix",
      "description": "A chat starting with this becomes a question. Without a ticket condition, no ticket is needed.",
      "type": "text",
      "defaultValue": "!q",
      "group": "Questions"
    },
    {
      "id": "designEmbed",
      "label": "Embed",
      "description": "Discord-style card behind the question (accent stripe + fill).",
      "type": "checkbox",
      "defaultValue": true,
      "group": "Content",
      "category": "Design"
    },
    {
      "id": "designEmbedColor",
      "label": "Content Colour",
      "type": "color",
      "defaultValue": "#ffffff",
      "group": "Content",
      "category": "Design"
    },
    {
      "id": "designEmbedOpacity",
      "label": "Content Opacity",
      "type": "slider",
      "defaultValue": 5,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Content",
      "category": "Design"
    },
    {
      "id": "designContentRadius",
