  "settings": [
    {
      "id": "obsAddress",
      "label": "Server IP",
      "type": "text",
      "defaultValue": "127.0.0.1",
      "group": "OBS Connection"
    },
    {
      "id": "obsPort",
      "label": "Port",
      "type": "number",
      "defaultValue": 4455,
      "min": 1024,
      "max": 65535,
      "group": "OBS Connection"
    },
    {
      "id": "obsPassword",
      "label": "Password",
      "type": "password",
      "defaultValue": "",
      "group": "OBS Connection"
    },
    {
      "id": "bridgeHost",
      "label": "Bridge Host",
      "type": "text",
      "defaultValue": "127.0.0.1",
      "group": "Connection"
    },
    {
      "id": "bridgePort",
      "label": "Bridge Port",
      "type": "number",
      "defaultValue": 47800,
      "min": 1024,
      "max": 65535,
      "group": "Connection"
    },
    {
      "id": "ticketGiftId",
      "label": "Ticket Gift",
      "description": "Pick a gift to require before someone may ask. The list shows every TikTok gift with its coin price and id, so matching stays exact across languages. Leave it empty and anyone can ask with just the prefix.",
      "type": "gift",
      "defaultValue": "",
      "group": "Ticket",
      "full": true
    },
    {
      "id": "questionPrefix",
      "label": "Question Prefix",
      "description": "A chat starting with this becomes a question. Without a ticket gift, no ticket is needed.",
      "type": "text",
      "defaultValue": "!q",
      "group": "Questions"
    },
    {
      "id": "designFont",
      "label": "Font",
      "description": "Font used by the whole card. Any font installed on this PC works.",
      "type": "font",
      "defaultValue": "Archivo",
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designNameSize",
      "label": "Name Size",
      "type": "slider",
      "defaultValue": 22,
      "min": 10,
      "max": 48,
      "step": 1,
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designTextSize",
      "label": "Question Size",
      "type": "slider",
      "defaultValue": 20,
      "min": 12,
      "max": 64,
      "step": 1,
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designColorName",
      "label": "Name Colour",
      "description": "Colour of the asker's name.",
      "type": "color",
      "defaultValue": "#d4a843",
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designColorText",
      "label": "Question Colour",
      "description": "Colour of the question text.",
      "type": "color",
      "defaultValue": "#f1eef5",
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designColorHint",
      "label": "Hint Colour",
      "description": "Colour of the ticket hint line.",
      "type": "color",
      "defaultValue": "#a8a3b0",
      "group": "Text",
      "category": "Design"
    },
    {
      "id": "designHighlightOn",
      "label": "Highlight",
